# העתק לקובץ .env ומלא את הערכים. אל תעלה את .env ל-GitHub.

# הכתובת של הדשבורד
DOMAIN=elichay.duckdns.org
DUCKDNS_SUBDOMAIN=elichay
DUCKDNS_TOKEN=

# גרסת WAHA לפי סוג המעבד של השרת:
#   Oracle Cloud (Arm):  arm-2026.10.1
#   Hetzner או כל שרת x86:  latest-2026.10.1
WAHA_IMAGE_TAG=latest-2026.10.1

# המספר שלך בפורמט בינלאומי בלי + ובלי מקפים (למשל 972501234567)
OWNER_PHONE=

# אופציונלי. ה-LID של אותו חשבון, מזהה הפרטיות של וואטסאפ. אם ריק,
# המערכת שולפת אותו מ-WAHA לבד. למלא רק אם השליפה נכשלת
OWNER_LID=

# סיסמאות: צור מחרוזות אקראיות ארוכות, למשל עם: openssl rand -hex 24
POSTGRES_PASSWORD=
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=

# כמה ימים נשמרת הכניסה לדשבורד לפני שנדרש קוד חדש. ברירת המחדל בקוד היא 30.
# התוקף נקבע ברגע ההתחברות, ולכן שינוי כאן משפיע רק על כניסות חדשות.
# בשרת של המשתמש מוגדר 365 (הוחלט 29.10.2026).
SESSION_DAYS=365

# --- הבוט בוואטסאפ (שלב 2א) ---
# המפתח שבו WAHA חותם את ההודעות שהוא שולח ל-backend. גם הוא מחרוזת אקראית.
# כשהוא ריק הבוט כבוי: ה-webhook דוחה כל בקשה ולולאת התזכורות לא עולה.
WAHA_WEBHOOK_HMAC_KEY=

# מפתח Claude API, מתוך console.anthropic.com. בלעדיו הבוט לא מבין הודעות.
ANTHROPIC_API_KEY=
# ברירת המחדל בקוד: claude-opus-5-5. אפשר claude-haiku-5-5 כדי להוזיל.
CLAUDE_MODEL=claude-opus-5-5
# עומק החשיבה: low, medium, high, xhigh, max. ברירת המחדל בקוד: low
CLAUDE_EFFORT=low

# --- התראות פוש (שלב 2ה) ---
# וואטסאפ לא מתריע על הודעה שאדם שולח לעצמו, ולכן התזכורת יוצאת גם
# כהתראת פוש דרך ntfy. בלי שלושת הערכים האלה הפוש לא נשלח והתזכורות
# ממשיכות להגיע בוואטסאפ בלבד — שום דבר לא נשבר.

# הכתובת של שרת ההתראות. תת-כתובת של הדומיין, ו-Caddy מנפיק לה תעודה לבד
NTFY_DOMAIN=ntfy.elichay.duckdns.org

# שם הנושא, והוא חלק מהסוד. מחרוזת אקראית: openssl rand -hex 12
NTFY_TOPIC=

# טוקן עם הרשאת כתיבה לנושא הזה בלבד. נוצר בתוך הקונטיינר, אחרי הפריסה:
#   sudo docker compose exec ntfy ntfy user add --role=user bot
#   sudo docker compose exec ntfy ntfy access bot "<הנושא>" write
#   sudo docker compose exec ntfy ntfy token add bot
# ולטלפון נוצר משתמש שני עם הרשאת read בלבד, והטוקן שלו נכנס לאפליקציה
# ולא לקובץ הזה
NTFY_TOKEN=
