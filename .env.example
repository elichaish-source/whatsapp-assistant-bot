# העתק לקובץ .env ומלא את הערכים. אל תעלה את .env ל-GitHub.

# הכתובת של הדשבורד
DOMAIN=elichay.duckdns.org
DUCKDNS_SUBDOMAIN=elichay
DUCKDNS_TOKEN=

# גרסת WAHA לפי סוג המעבד של השרת:
#   Oracle Cloud (Arm):  arm-2026.9.2
#   Hetzner או כל שרת x86:  latest-2026.9.2
WAHA_IMAGE_TAG=arm-2026.9.2

# המספר שלך בפורמט בינלאומי בלי + ובלי מקפים (למשל 972501234567)
OWNER_PHONE=

# סיסמאות: צור מחרוזות אקראיות ארוכות, למשל עם: openssl rand -hex 24
POSTGRES_PASSWORD=
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=

# כמה ימים נשמרת הכניסה לדשבורד לפני שנדרש קוד חדש. ברירת המחדל בקוד היא 30.
# התוקף נקבע ברגע ההתחברות, ולכן שינוי כאן משפיע רק על כניסות חדשות.
# בשרת של המשתמש מוגדר 365 (הוחלט 29.10.2026).
SESSION_DAYS=365
