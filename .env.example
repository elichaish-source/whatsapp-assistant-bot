# העתק לקובץ .env ומלא את הערכים. אל תעלה את .env ל-GitHub.

# הכתובת של הדשבורד
DOMAIN=elichay.duckdns.org
DUCKDNS_SUBDOMAIN=elichay
DUCKDNS_TOKEN=

# גרסת WAHA לפי סוג המעבד של השרת:
#   Oracle Cloud (Arm):  arm-2026.9.2
#   Hetzner או כל שרת x86:  latest-2026.9.2
WAHA_IMAGE_TAG=arm-2026.9.2

# המספר שלך בפורמט בינלאומי בלי + ובלי מקפים (למשל 972501234567)
OWNER_PHONE=

# סיסמאות: צור מחרוזות אקראיות ארוכות, למשל עם: openssl rand -hex 24
POSTGRES_PASSWORD=
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=

# --- הבוט בוואטסאפ (שלב 2א) ---
# המפתח שבו WAHA חותם את ההודעות שהוא שולח ל-backend. גם הוא מחרוזת אקראית.
# כשהוא ריק הבוט כבוי: ה-webhook דוחה כל בקשה ולולאת התזכורות לא עולה.
WAHA_WEBHOOK_HMAC_KEY=

# מפתח Claude API, מתוך console.anthropic.com. בלעדיו הבוט לא מבין הודעות.
ANTHROPIC_API_KEY=
# ברירת המחדל בקוד: claude-opus-5-5. אפשר claude-haiku-5-5 כדי להוזיל.
CLAUDE_MODEL=claude-opus-5-5
# עומק החשיבה: low, medium, high, xhigh, max. ברירת המחדל בקוד: low
CLAUDE_EFFORT=low
